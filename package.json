{
  "name": "nimue-excalidraw-github",
  "version": "1.0.0",
  "description": "Nimue — Github Storage for Excalidraw",
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "pnpm build && rm -f nimue-excalidraw-github.zip && cd dist && zip -r ../nimue-excalidraw-github.zip .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "5.5.0",
    "webextension-polyfill": "^0.10.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@types/chrome": "^0.0.254",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "terser": "^5.28.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
