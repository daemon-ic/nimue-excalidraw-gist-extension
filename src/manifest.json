{
  "manifest_version": 3,
  "name": "Nimue — Github Storage for Excalidraw",
  "version": "1.0.0",
  "description": "Save, load, and autosync Excalidraw drawings to a private GitHub repository.",
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["https://excalidraw.com/*", "https://api.github.com/*"],
  "action": {
    "default_title": "Nimue",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/assets/icon-32.png", "src/assets/icon-48.png"],
      "matches": ["https://excalidraw.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://excalidraw.com/*"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ]
}
