{
  "manifest_version": 3,
  "name": "Chrome Extension with Vite",
  "version": "1.0.0",
  "description": "A modern Chrome extension built with Vite, Tailwind CSS, and TypeScript",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome Extension"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://excalidraw.com/*"]
    }
  ],
  "host_permissions": ["https://excalidraw.com/*"],
  "content_scripts": [
    {
      "matches": ["https://excalidraw.com/*"],
      "js": ["js/content.js"]
    }
  ]
} 