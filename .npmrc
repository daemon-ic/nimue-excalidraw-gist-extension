# pnpm configuration for Chrome Extension project

# Enable strict mode (prevents phantom dependencies)
strict-peer-dependencies=false

# Use exact versions for better reproducibility
save-exact=true

# Enable workspace features if needed
link-workspace-packages=true

# Configure registry (optional - uses default npm registry)
# registry=https://registry.npmjs.org/

# Enable pnpm store for better performance
store-dir=.pnpm-store 